{% comment %}Aweris homepage section 04 - Workflow. Paste into sections/aweris-workflow.liquid{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .aweris-section {
    --aweris-orange: {{ section.settings.orange_color | default: '#E94E1A' }};
    --aweris-yellow: {{ section.settings.yellow_color | default: '#E9E11E' }};
    --aweris-blue: {{ section.settings.blue_color | default: '#3B4058' }};
    --aweris-cream: {{ section.settings.cream_color | default: '#F4EEDF' }};
    --aweris-white: #ffffff;
    --aweris-text: {{ section.settings.text_color | default: '#222222' }};
    --aweris-muted: {{ section.settings.muted_color | default: '#5F6270' }};
    --aweris-radius: {{ section.settings.border_radius | default: 24 }}px;
    --aweris-max: {{ section.settings.max_width | default: 1200 }}px;
    color: var(--aweris-text);
    background: {{ section.settings.background_color | default: '#F4EEDF' }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .aweris-container {
    max-width: var(--aweris-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top | default: 72 }}px 24px {{ section.settings.padding_bottom | default: 72 }}px;
  }

  #shopify-section-{{ section.id }} .aweris-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--aweris-orange);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .aweris-eyebrow:before {
    content: "";
    width: 34px;
    height: 2px;
    background: var(--aweris-orange);
    display: inline-block;
  }

  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 {
    margin: 0;
    color: var(--aweris-blue);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} h1 {
    font-size: clamp(42px, 7vw, 88px);
  }

  #shopify-section-{{ section.id }} h2 {
    font-size: clamp(32px, 4.4vw, 58px);
  }

  #shopify-section-{{ section.id }} h3 {
    font-size: clamp(22px, 2vw, 30px);
  }

  #shopify-section-{{ section.id }} p {
    margin: 0;
    color: var(--aweris-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .aweris-lead {
    font-size: clamp(18px, 2vw, 22px);
    color: var(--aweris-text);
  }

  #shopify-section-{{ section.id }} .aweris-button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  #shopify-section-{{ section.id }} .aweris-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    border: 1px solid transparent;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #shopify-section-{{ section.id }} .aweris-button:hover {
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .aweris-button-primary {
    background: var(--aweris-orange);
    color: var(--aweris-white);
    box-shadow: 0 14px 30px rgba(233, 78, 26, .22);
  }

  #shopify-section-{{ section.id }} .aweris-button-secondary {
    background: rgba(255,255,255,.76);
    color: var(--aweris-blue);
    border-color: rgba(59, 64, 88, .16);
  }

  #shopify-section-{{ section.id }} .aweris-card {
    background: rgba(255,255,255,.82);
    border: 1px solid rgba(59,64,88,.12);
    border-radius: var(--aweris-radius);
    padding: 28px;
    box-shadow: 0 14px 38px rgba(59,64,88,.07);
  }

  #shopify-section-{{ section.id }} .aweris-card h3 {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .aweris-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .aweris-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .aweris-grid-2,
    #shopify-section-{{ section.id }} .aweris-grid-3,
    #shopify-section-{{ section.id }} .aweris-split {
      grid-template-columns: 1fr !important;
    }
  }

  @media screen and (max-width: 700px) {
    #shopify-section-{{ section.id }} .aweris-container {
      padding-left: 18px;
      padding-right: 18px;
    }
    #shopify-section-{{ section.id }} .aweris-button {
      width: 100%;
    }
  }
</style>

<section class="aweris-section">
  <style>
    #shopify-section-{{ section.id }} .aweris-split {
      display: grid;
      grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
      gap: 48px;
      align-items: center;
    }
    #shopify-section-{{ section.id }} .aweris-steps {
      counter-reset: step;
      display: grid;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .aweris-step {
      counter-increment: step;
      display: grid;
      grid-template-columns: 54px 1fr;
      gap: 16px;
      align-items: start;
      background: white;
      border-radius: var(--aweris-radius);
      padding: 20px;
      border: 1px solid rgba(59,64,88,.10);
    }
    #shopify-section-{{ section.id }} .aweris-step:before {
      content: counter(step);
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--aweris-orange);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
    }
    #shopify-section-{{ section.id }} .aweris-step h3 {
      font-size: 20px;
      margin-bottom: 6px;
    }
  </style>
  <div class="aweris-container">
    <div class="aweris-split">
      <div>
        {% if section.settings.eyebrow != blank %}<div class="aweris-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
        {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
        {% if section.settings.text != blank %}<div style="margin-top:22px;"><p>{{ section.settings.text }}</p></div>{% endif %}
      </div>

      <div class="aweris-steps">
        {% for block in section.blocks %}
          <div class="aweris-step" {{ block.shopify_attributes }}>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aweris 04 Workflow",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "From first referral to every session that follows."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Aweris connects the main steps of care into one workflow so therapists can avoid repeating manual paperwork across disconnected tools."
    },

    {
      "type": "header",
      "content": "Aweris brand settings"
    },
    {
      "type": "color",
      "id": "orange_color",
      "label": "Orange",
      "default": "#E94E1A"
    },
    {
      "type": "color",
      "id": "yellow_color",
      "label": "Soft yellow",
      "default": "#E9E11E"
    },
    {
      "type": "color",
      "id": "blue_color",
      "label": "Deep blue",
      "default": "#3B4058"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#F4EEDF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F4EEDF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5F6270"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 900,
      "max": 1500,
      "step": 50,
      "default": 1200
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }

  ],
  "blocks": [
    {
      "type": "step",
      "name": "Workflow step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Invite with a referral code"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Step text",
          "default": "Patients and therapists enter through controlled referral-based onboarding instead of open public sign-up."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aweris 04 Workflow",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Invite with a referral code",
            "text": "Patients and therapists enter through controlled referral-based onboarding instead of open public sign-up."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Complete guided intake",
            "text": "Patients answer structured questionnaires before therapy begins, giving the therapist useful context from the start."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Transcribe and summarize sessions",
            "text": "Intake and therapy sessions can be recorded and transcribed so the therapist can stay present instead of writing everything manually."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Review and send follow-up work",
            "text": "Aweris drafts summaries, homework, and questionnaires, then the therapist reviews and approves them before the patient receives them."
          }
        }
      ]
    }
  ]
}
{% endschema %}
