<style>
  html {
    scroll-behavior: smooth;
  }

  #shopify-section-{{ section.id }} {
    --aweris-orange: #E94E1A;
    --aweris-yellow: #E9E11E;
    --aweris-blue: #3B4058;
    --aweris-cream: #F4EEDF;
    --aweris-cream-light: #fbf5ea;
    --aweris-card: #fffdf8;
    --aweris-text: #3B4058;
    --aweris-muted: #667086;
    --aweris-line: rgba(59, 64, 88, .18);
    --aweris-shadow: 0 22px 54px rgba(59, 64, 88, .12);
    color: var(--aweris-text);
    background: var(--aweris-cream-light);
    font-family: var(--font-body--family);
  }

  #shopify-section-{{ section.id }} * {
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .aweris-page {
    min-height: 100vh;
    background: var(--aweris-cream-light);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .aweris-container {
    width: min(1140px, calc(100% - 40px));
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .aweris-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(251, 245, 234, .94);
    border-bottom: 1px solid rgba(59, 64, 88, .12);
    backdrop-filter: blur(14px);
  }

  #shopify-section-{{ section.id }} .aweris-nav {
    min-height: 70px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .aweris-logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .aweris-logo img {
    width: clamp(124px, 18vw, 178px);
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .aweris-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .aweris-menu {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #shopify-section-{{ section.id }} .aweris-nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 2px solid var(--aweris-blue);
    border-radius: 999px;
    background: transparent;
    color: var(--aweris-blue);
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .aweris-nav-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    margin: 4px auto;
    background: currentColor;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .aweris-menu a,
  #shopify-section-{{ section.id }} .aweris-login-summary,
  #shopify-section-{{ section.id }} .aweris-login-option {
    color: var(--aweris-blue);
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .aweris-menu a,
  #shopify-section-{{ section.id }} .aweris-login-summary {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    padding: 9px 14px;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .aweris-login-summary {
    border: 2px solid var(--aweris-blue);
    list-style: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .aweris-login-summary::-webkit-details-marker {
    display: none;
  }

  #shopify-section-{{ section.id }} .aweris-login-summary::after {
    content: "";
    width: 7px;
    height: 7px;
    margin-left: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
  }

  #shopify-section-{{ section.id }} .aweris-login {
    position: relative;
  }

  #shopify-section-{{ section.id }} .aweris-login-panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    gap: 8px;
    min-width: 220px;
    padding: 10px;
    background: var(--aweris-card);
    border: 1px solid var(--aweris-line);
    border-radius: 8px;
    box-shadow: var(--aweris-shadow);
  }

  #shopify-section-{{ section.id }} .aweris-login-option {
    width: 100%;
    padding: 12px 14px;
    border: 0;
    border-radius: 6px;
    background: rgba(244, 238, 223, .76);
    text-align: left;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .aweris-login-app {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 12px;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .aweris-swatch {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(233, 78, 26, .12);
    color: var(--aweris-orange);
  }

  #shopify-section-{{ section.id }} .aweris-login-app:nth-child(2) .aweris-swatch {
    background: rgba(59, 64, 88, .12);
    color: var(--aweris-blue);
  }

  #shopify-section-{{ section.id }} .aweris-login-app:nth-child(3) .aweris-swatch {
    background: rgba(233, 225, 30, .28);
    color: #9a6a10;
  }

  #shopify-section-{{ section.id }} .aweris-login-copy {
    display: grid;
    gap: 2px;
  }

  #shopify-section-{{ section.id }} .aweris-login-copy span {
    color: var(--aweris-muted);
    font-size: 12px;
    font-weight: 700;
  }

  #shopify-section-{{ section.id }} .aweris-login-option:hover,
  #shopify-section-{{ section.id }} .aweris-menu a:hover {
    background: rgba(233, 78, 26, .1);
  }

  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3,
  #shopify-section-{{ section.id }} p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .aweris-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
    color: var(--aweris-orange);
    font-size: 14px;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .aweris-kicker::before {
    content: "";
    width: 28px;
    height: 2px;
    background: var(--aweris-orange);
  }

  #shopify-section-{{ section.id }} .aweris-hero {
    padding: 116px 0 84px;
    background:
      radial-gradient(circle at 88% 18%, rgba(233, 78, 26, .1), transparent 28%),
      radial-gradient(circle at 12% 12%, rgba(233, 225, 30, .18), transparent 24%),
      var(--aweris-cream-light);
  }

  #shopify-section-{{ section.id }} .aweris-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(440px, .86fr);
    gap: clamp(44px, 7vw, 92px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} h1 {
    max-width: 720px;
    color: var(--aweris-blue);
    font-family: var(--font-heading--family);
    font-size: clamp(46px, 6.6vw, 76px);
    line-height: .98;
  }

  #shopify-section-{{ section.id }} .aweris-highlight {
    position: relative;
    color: var(--aweris-blue);
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .aweris-highlight::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: .08em;
    height: .14em;
    background: var(--aweris-yellow);
    z-index: -1;
  }

  #shopify-section-{{ section.id }} .aweris-lead {
    max-width: 690px;
    margin-top: 26px;
    color: var(--aweris-muted);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.58;
  }

  #shopify-section-{{ section.id }} .aweris-actions,
  #shopify-section-{{ section.id }} .aweris-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  #shopify-section-{{ section.id }} .aweris-actions {
    margin-top: 34px;
  }

  #shopify-section-{{ section.id }} .aweris-button {
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    border-radius: 999px;
    border: 2px solid var(--aweris-blue);
    color: var(--aweris-blue);
    font-weight: 900;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .aweris-button-primary {
    border-color: var(--aweris-orange);
    background: var(--aweris-orange);
    color: #fff;
    box-shadow: 0 18px 34px rgba(233, 78, 26, .22);
  }

  #shopify-section-{{ section.id }} .aweris-trust {
    margin-top: 30px;
  }

  #shopify-section-{{ section.id }} .aweris-trust span {
    position: relative;
    max-width: 260px;
    padding-left: 24px;
    color: var(--aweris-muted);
    font-weight: 700;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .aweris-trust span::before {
    content: "";
    position: absolute;
    left: 0;
    top: .7em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--aweris-orange);
  }

  #shopify-section-{{ section.id }} .aweris-visual {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  #shopify-section-{{ section.id }} .aweris-tile {
    position: relative;
    min-height: 210px;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(59, 64, 88, .18);
    box-shadow: var(--aweris-shadow);
  }

  #shopify-section-{{ section.id }} .aweris-tile::before {
    content: "";
    position: absolute;
    inset: auto 18px 16px auto;
    width: min(58%, 180px);
    aspect-ratio: 1;
    background: var(--aweris-tile-art) center / contain no-repeat;
    opacity: .92;
    filter: drop-shadow(0 14px 22px rgba(59, 64, 88, .22));
  }

  #shopify-section-{{ section.id }} .aweris-tile:nth-child(1) {
    background: var(--aweris-orange);
    --aweris-tile-art: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='32' y='20' width='92' height='126' rx='14' fill='%23fff6e7'/%3E%3Cpath d='M52 55h52M52 78h48M52 101h32' stroke='%233B4058' stroke-width='8' stroke-linecap='round'/%3E%3Ccircle cx='126' cy='118' r='36' fill='%23E9E11E' fill-opacity='.82'/%3E%3Cpath d='M112 116h28M126 102v28' stroke='%23E94E1A' stroke-width='7' stroke-linecap='round'/%3E%3C/svg%3E");
  }

  #shopify-section-{{ section.id }} .aweris-tile:nth-child(2) {
    margin-top: 22px;
    background: var(--aweris-blue);
    --aweris-tile-art: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='88' cy='78' r='38' fill='%23E9E11E' fill-opacity='.84'/%3E%3Cpath d='M62 78l18 18 42-48' fill='none' stroke='%233B4058' stroke-width='12' stroke-linecap='round' stroke-linejoin='round'/%3E%3Crect x='44' y='116' width='92' height='22' rx='11' fill='%23fff6e7'/%3E%3Ccircle cx='140' cy='118' r='32' fill='%23fff6e7' fill-opacity='.38'/%3E%3C/svg%3E");
  }

  #shopify-section-{{ section.id }} .aweris-tile:nth-child(3) {
    background: #e89b22;
    --aweris-tile-art: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='38' y='26' width='104' height='128' rx='16' fill='%23fff6e7'/%3E%3Cpath d='M60 58h60M60 84h60M60 110h60' stroke='%233B4058' stroke-width='7' stroke-linecap='round'/%3E%3Ccircle cx='62' cy='58' r='9' fill='%23E9E11E'/%3E%3Ccircle cx='62' cy='84' r='9' fill='%23E9E11E'/%3E%3Ccircle cx='62' cy='110' r='9' fill='%23E9E11E'/%3E%3Cpath d='M57 58l4 4 9-10M57 84l4 4 9-10M57 110l4 4 9-10' stroke='%23E94E1A' stroke-width='4' fill='none' stroke-linecap='round'/%3E%3C/svg%3E");
  }

  #shopify-section-{{ section.id }} .aweris-tile:nth-child(4) {
    margin-top: 18px;
    background: #eebc9d;
    --aweris-tile-art: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M42 52h96a18 18 0 0 1 18 18v28a18 18 0 0 1-18 18H90l-30 26v-26H42a18 18 0 0 1-18-18V70a18 18 0 0 1 18-18Z' fill='%23fff6e7'/%3E%3Ccircle cx='68' cy='84' r='8' fill='%23E94E1A'/%3E%3Ccircle cx='91' cy='84' r='8' fill='%23E9E11E'/%3E%3Ccircle cx='114' cy='84' r='8' fill='%233B4058'/%3E%3Cpath d='M130 38c14 8 22 22 22 38' stroke='%233B4058' stroke-width='8' stroke-linecap='round' fill='none' opacity='.7'/%3E%3C/svg%3E");
  }

  #shopify-section-{{ section.id }} .aweris-tile:nth-child(5) {
    background: var(--aweris-yellow);
    --aweris-tile-art: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='30' y='34' width='120' height='100' rx='14' fill='%23fff6e7'/%3E%3Cpath d='M50 112V90M78 112V72M106 112V84M134 112V58' stroke='%233B4058' stroke-width='10' stroke-linecap='round'/%3E%3Cpath d='M50 58h42M50 136h80' stroke='%23E94E1A' stroke-width='7' stroke-linecap='round'/%3E%3Ccircle cx='132' cy='56' r='16' fill='%23E94E1A' fill-opacity='.8'/%3E%3C/svg%3E");
  }

  #shopify-section-{{ section.id }} .aweris-tile:nth-child(6) {
    margin-top: 18px;
    background: #c73918;
    --aweris-tile-art: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Crect x='40' y='22' width='96' height='136' rx='14' fill='%23fff6e7'/%3E%3Cpath d='M62 58h52M62 82h52M62 106h38' stroke='%233B4058' stroke-width='7' stroke-linecap='round'/%3E%3Cpath d='M60 130c18-16 35-16 52 0' stroke='%23E94E1A' stroke-width='7' stroke-linecap='round' fill='none'/%3E%3Ccircle cx='124' cy='126' r='32' fill='%23E9E11E' fill-opacity='.76'/%3E%3C/svg%3E");
  }

  #shopify-section-{{ section.id }} .aweris-flower,
  #shopify-section-{{ section.id }} .aweris-flower::before,
  #shopify-section-{{ section.id }} .aweris-flower::after {
    position: absolute;
    content: "";
    border-radius: 62% 38% 58% 42%;
  }

  #shopify-section-{{ section.id }} .aweris-flower {
    width: 102px;
    height: 130px;
    right: -18px;
    bottom: -36px;
    background: rgba(244, 238, 223, .5);
    transform: rotate(18deg);
  }

  #shopify-section-{{ section.id }} .aweris-flower::before {
    width: 82px;
    height: 62px;
    right: 44px;
    bottom: 40px;
    background: rgba(233, 225, 30, .72);
  }

  #shopify-section-{{ section.id }} .aweris-flower::after {
    width: 76px;
    height: 76px;
    right: -38px;
    bottom: 54px;
    background: rgba(59, 64, 88, .72);
  }

  #shopify-section-{{ section.id }} .aweris-product-card {
    position: absolute;
    left: 18px;
    top: 18px;
    right: 18px;
    padding: 14px;
    border-radius: 12px;
    background: rgba(255, 253, 248, .86);
    color: var(--aweris-blue);
    font-size: 13px;
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .aweris-strip {
    background: var(--aweris-blue);
    color: #fff;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .aweris-strip-track {
    width: max-content;
    min-width: 100%;
    display: flex;
    align-items: center;
    gap: 48px;
    padding: 18px 0;
    animation: aweris-marquee 34s linear infinite;
  }

  #shopify-section-{{ section.id }} .aweris-strip-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: rgba(255, 255, 255, .9);
    font-weight: 900;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .aweris-strip-item::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--aweris-yellow);
    box-shadow:
      8px 0 0 var(--aweris-yellow),
      4px 7px 0 var(--aweris-yellow),
      4px -7px 0 var(--aweris-yellow);
  }

  @keyframes aweris-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  #shopify-section-{{ section.id }} .aweris-section {
    padding: 86px 0;
  }

  #shopify-section-{{ section.id }} .aweris-about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, .9fr);
    gap: clamp(38px, 6vw, 82px);
    align-items: center;
  }

  #shopify-section-{{ section.id }} .aweris-section h2 {
    max-width: 680px;
    color: var(--aweris-blue);
    font-family: var(--font-heading--family);
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.05;
  }

  #shopify-section-{{ section.id }} .aweris-section-copy {
    max-width: 720px;
    margin-top: 18px;
    color: var(--aweris-muted);
    font-size: 20px;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .aweris-points {
    display: grid;
    gap: 22px;
    margin-top: 36px;
  }

  #shopify-section-{{ section.id }} .aweris-point {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    align-items: start;
  }

  #shopify-section-{{ section.id }} .aweris-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: #fff;
    color: var(--aweris-orange);
    box-shadow: 0 10px 24px rgba(59, 64, 88, .1);
  }

  #shopify-section-{{ section.id }} .aweris-point strong,
  #shopify-section-{{ section.id }} .aweris-security-card strong {
    display: block;
    color: var(--aweris-blue);
    font-size: 18px;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .aweris-point p {
    margin-top: 7px;
    color: var(--aweris-muted);
    font-size: 16px;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .aweris-principle {
    position: relative;
    padding: 42px;
    border-radius: 24px;
    background: var(--aweris-blue);
    color: #fff;
    overflow: hidden;
    box-shadow: var(--aweris-shadow);
  }

  #shopify-section-{{ section.id }} .aweris-principle p {
    position: relative;
    z-index: 1;
    color: #fff;
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 900;
    line-height: 1.28;
  }

  #shopify-section-{{ section.id }} .aweris-principle em {
    color: var(--aweris-yellow);
    font-style: normal;
  }

  #shopify-section-{{ section.id }} .aweris-principle::after {
    content: "";
    position: absolute;
    right: -64px;
    bottom: -76px;
    width: 260px;
    height: 260px;
    border: 14px solid rgba(233, 78, 26, .18);
    border-radius: 58% 42% 52% 48%;
  }

  #shopify-section-{{ section.id }} .aweris-bloom {
    position: absolute;
    right: -54px;
    bottom: -76px;
    width: min(260px, 48%);
    opacity: .2;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .aweris-principle-label {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 26px;
    color: rgba(255, 255, 255, .86);
    font-weight: 800;
  }

  #shopify-section-{{ section.id }} .aweris-principle-label::before {
    content: "";
    width: 28px;
    height: 2px;
    background: var(--aweris-orange);
  }

  #shopify-section-{{ section.id }} .aweris-features {
    background: var(--aweris-cream);
  }

  #shopify-section-{{ section.id }} .aweris-centered {
    max-width: 620px;
    margin: 0 auto 44px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .aweris-centered .aweris-kicker {
    justify-content: center;
  }

  #shopify-section-{{ section.id }} .aweris-centered .aweris-kicker::before {
    display: none;
  }

  #shopify-section-{{ section.id }} .aweris-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  #shopify-section-{{ section.id }} .aweris-card {
    min-height: 208px;
    padding: 24px;
    border: 1px solid rgba(59, 64, 88, .16);
    border-radius: 8px;
    background: var(--aweris-card);
    box-shadow: 0 14px 36px rgba(59, 64, 88, .07);
  }

  #shopify-section-{{ section.id }} .aweris-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    margin-bottom: 18px;
  }

  #shopify-section-{{ section.id }} .aweris-card h3 {
