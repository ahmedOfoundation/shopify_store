<div class="aweris-page" id="home">
  <header class="aweris-header">
    <div class="aweris-container aweris-nav">
      <a class="aweris-logo" href="#home" aria-label="Awares home">
        <img src="{{ 'aweris-logo.png' | asset_url }}" alt="Awares" width="1100" height="205">
        <span class="aweris-sr">Awares</span>
      </a>
      <button class="aweris-nav-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="aweris-menu-{{ section.id }}">
        <span></span><span></span><span></span>
      </button>
      <nav class="aweris-menu" id="aweris-menu-{{ section.id }}" aria-label="Main navigation">
        <a href="#home">Home</a>
        <details class="aweris-login">
          <summary class="aweris-login-summary">Login</summary>
          <div class="aweris-login-panel" role="group" aria-label="Login destinations">
            <button class="aweris-login-option aweris-login-app" type="button">
              <span class="aweris-swatch">01</span>
              <span class="aweris-login-copy"><strong>Bookkeeping App</strong></span>
            </button>
            <button class="aweris-login-option aweris-login-app" type="button">
              <span class="aweris-swatch">02</span>
              <span class="aweris-login-copy"><strong>Psychologists App</strong></span>
            </button>
            <button class="aweris-login-option aweris-login-app" type="button">
              <span class="aweris-swatch">03</span>
              <span class="aweris-login-copy"><strong>Client App</strong></span>
            </button>
          </div>
        </details>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="aweris-hero" aria-labelledby="aweris-hero-title">
      <div class="aweris-container aweris-hero-grid">
        <div>
          <h1 id="aweris-hero-title">Automate the <span class="aweris-highlight">administrative</span> workload of your mental healthcare practice</h1>
          <p class="aweris-lead">Awares helps GGZ and psychology practices automate bookkeeping, questionnaires, reporting, email handling, scheduling, dashboards, and client support - securely within their own environment.</p>
          <div class="aweris-actions">
            <a class="aweris-button aweris-button-primary" href="#contact">Contact us</a>
          </div>
        </div>

        <div class="aweris-visual" aria-hidden="true">
          <div class="aweris-tile"><span class="aweris-product-card">Automatic bookkeeping in Exact</span><span class="aweris-flower"></span></div>
          <div class="aweris-tile"><span class="aweris-product-card">Human approval required</span><span class="aweris-flower"></span></div>
          <div class="aweris-tile"><span class="aweris-product-card">Questionnaires and diagnostics</span><span class="aweris-flower"></span></div>
          <div class="aweris-tile"><span class="aweris-product-card">Client support</span><span class="aweris-flower"></span></div>
          <div class="aweris-tile"><span class="aweris-product-card">Secretariat dashboards</span><span class="aweris-flower"></span></div>
          <div class="aweris-tile"><span class="aweris-product-card">Session reporting</span><span class="aweris-flower"></span></div>
        </div>
      </div>
    </section>

    <section class="aweris-section" id="what-is-aweris" aria-labelledby="aweris-about-title">
      <div class="aweris-container aweris-about-grid">
        <div>
          <h2 id="aweris-about-title">What is Awares?</h2>
          <p class="aweris-section-copy">Awares is a smart automation platform for GGZ and mental healthcare practices. It helps practices reduce repetitive administrative work, improve workflow efficiency, and free up more time for client care.</p>
          <p class="aweris-section-copy">The platform supports electronic patient file workflows, session reporting, accounting, questionnaires, client communication, scheduling, dashboards, and customized workflow automation.</p>
        </div>
        <aside class="aweris-principle">
          <p>AI and automation support the work, but the healthcare professional always decides what is included in clinical reports and client communication.</p>
          <span class="aweris-principle-label">Human control</span>
          <img class="aweris-bloom" src="{{ 'aweris-bloom-about.png' | asset_url }}" alt="" aria-hidden="true" width="898" height="1100">
        </aside>
      </div>
    </section>

    <section class="aweris-section aweris-features" id="features" aria-labelledby="aweris-features-title">
      <div class="aweris-container">
        <div class="aweris-centered">
          <p class="aweris-kicker">Feature grid</p>
          <h2 id="aweris-features-title">Feature copy blocks</h2>
          <p class="aweris-section-copy">Use clear cards or blocks. Each feature should be explained in two or three short lines.</p>
        </div>
        <div class="aweris-feature-grid">
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">01</span><span class="aweris-number">01</span></div>
            <h3>Automatic bookkeeping in Exact</h3>
            <p>Invoices can be photographed or uploaded and then automatically processed in the practice&rsquo;s Exact environment. The system is self-learning and improves based on previous bookings.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">02</span><span class="aweris-number">02</span></div>
            <h3>Questionnaires and diagnostics</h3>
            <p>Send CQI, ROM, diagnostic, and practice-specific questionnaires automatically and securely through Zivver.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">03</span><span class="aweris-number">03</span></div>
            <h3>Automated email support</h3>
            <p>Automate a large share of incoming emails, including general questions, non-treatment-related care questions, and many internal staff questions.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">04</span><span class="aweris-number">04</span></div>
            <h3>Calling and scheduling automation</h3>
            <p>Support calls, appointment planning, reminders, and follow-ups. Clients can be contacted at suitable times, including outside office hours when useful.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">05</span><span class="aweris-number">05</span></div>
            <h3>Session reporting</h3>
            <p>Support reports for intakes, anamnesis, ADHD assessments, autism assessments, general mental healthcare, specialist mental healthcare, and regular sessions.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">06</span><span class="aweris-number">06</span></div>
            <h3>Client app and dossier access</h3>
            <p>Clients can access their dossier and relevant information through the client area of the app.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">07</span><span class="aweris-number">07</span></div>
            <h3>Personalized homework and e-health</h3>
            <p>Generate tailored homework and e-health content based on therapy sessions and session reports, then send it to the client.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">08</span><span class="aweris-number">08</span></div>
            <h3>Lifestyle support</h3>
            <p>Support clients with exercise and movement. Future functions can also support sleep improvement and nutrition improvement.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">09</span><span class="aweris-number">09</span></div>
            <h3>Secretariat dashboards</h3>
            <p>Create dashboards for the secretariat to monitor automated workflows and check whether tasks are running correctly.</p>
          </article>
          <article class="aweris-card">
            <div class="aweris-card-top"><span class="aweris-icon">10</span><span class="aweris-number">10</span></div>
            <h3>Custom automation</h3>
            <p>Add custom workflows when needed. The current platform already includes several functions, and new functions are added regularly.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="aweris-section" id="security" aria-labelledby="aweris-security-title">
      <div class="aweris-container aweris-security-grid">
        <div class="aweris-security-panel">
          <h2 id="aweris-security-title">Security and operating model</h2>
          <p>Awares is designed to run within the practice&rsquo;s own systems and secure environment. The platform can be operated remotely while keeping the practice&rsquo;s data and workflows inside its own infrastructure.</p>
          <p>This is important for mental healthcare practices that work with sensitive client information. Final privacy, security, and legal wording should be checked before publication.</p>
        </div>
      </div>
    </section>

    <section class="aweris-section aweris-contact" id="contact" aria-labelledby="aweris-contact-title">
      <div class="aweris-container aweris-contact-grid">
        <div class="aweris-contact-intro">
          <h2 id="aweris-contact-title">Interested in automating the administrative work of your mental healthcare practice?</h2>
          <p class="aweris-contact-text">Leave your details and we will contact you.</p>
          <img class="aweris-contact-bloom" src="{{ 'aweris-bloom-contact.png' | asset_url }}" alt="" aria-hidden="true" width="1100" height="1084">
        </div>

        {% form 'contact', class: 'aweris-form' %}
          {% if form.errors %}
            <p class="aweris-form-status">{{ form.errors | default_errors }}</p>
          {% endif %}

          <div class="aweris-field">
            <label for="ContactFormPracticeName">Practice name</label>
            <input id="ContactFormPracticeName" type="text" name="contact[Practice name]" autocomplete="organization">
          </div>
          <div class="aweris-field">
            <label for="ContactFormName">Name of owner, director, or decision-maker</label>
            <input id="ContactFormName" type="text" name="contact[name]" autocomplete="name">
          </div>
          <div class="aweris-field">
            <label for="ContactFormEmail">Email address</label>
            <input id="ContactFormEmail" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          <div class="aweris-field">
            <label for="ContactFormPhone">Phone number</label>
            <input id="ContactFormPhone" type="tel" name="contact[phone]" autocomplete="tel">
          </div>
          <div class="aweris-field aweris-field-wide">
            <label for="ContactFormMessage">Message</label>
            <textarea id="ContactFormMessage" name="contact[body]"></textarea>
          </div>
          <button class="aweris-submit" type="submit">Submit button</button>
        {% endform %}
      </div>
    </section>
  </main>

  <footer class="aweris-footer">
    <div class="aweris-container">
      <div class="aweris-footer-grid">
        <div>
          <a class="aweris-logo" href="#home" aria-label="Awares home">
            <img src="{{ 'aweris-logo.png' | asset_url }}" alt="Awares" width="1100" height="205">
            <span class="aweris-sr">Awares</span>
          </a>
          <p class="aweris-footer-copy">Smart automation for mental healthcare practices. <span>Less administration. More time for care.</span></p>
        </div>
        <div>
          <div class="aweris-footer-links">
            <a href="#contact">Contact</a>
            <a href="#home">Login</a>
          </div>
        </div>
      </div>
    </div>
  </footer>
</div>

<script>
  (() => {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    const toggle = root.querySelector('.aweris-nav-toggle');
    const menu = root.querySelector('.aweris-menu');

    if (toggle && menu) {
      toggle.addEventListener('click', () => {
        const isOpen = menu.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      menu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menu.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    }

    document.addEventListener('click', (event) => {
      root.querySelectorAll('.aweris-login[open]').forEach((details) => {
        if (!details.contains(event.target)) details.removeAttribute('open');
      });
    });
  })();
</script>

