{% comment %}Aweris homepage section 05 - Features. Paste into sections/aweris-features.liquid{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .aweris-section {
    --aweris-orange: {{ section.settings.orange_color | default: '#E94E1A' }};
    --aweris-yellow: {{ section.settings.yellow_color | default: '#E9E11E' }};
    --aweris-blue: {{ section.settings.blue_color | default: '#3B4058' }};
    --aweris-cream: {{ section.settings.cream_color | default: '#F4EEDF' }};
    --aweris-white: #ffffff;
    --aweris-text: {{ section.settings.text_color | default: '#222222' }};
    --aweris-muted: {{ section.settings.muted_color | default: '#5F6270' }};
    --aweris-radius: {{ section.settings.border_radius | default: 24 }}px;
    --aweris-max: {{ section.settings.max_width | default: 1200 }}px;
    color: var(--aweris-text);
    background: {{ section.settings.background_color | default: '#F4EEDF' }};
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .aweris-container {
    max-width: var(--aweris-max);
    margin: 0 auto;
    padding: {{ section.settings.padding_top | default: 72 }}px 24px {{ section.settings.padding_bottom | default: 72 }}px;
  }

  #shopify-section-{{ section.id }} .aweris-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--aweris-orange);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  #shopify-section-{{ section.id }} .aweris-eyebrow:before {
    content: "";
    width: 34px;
    height: 2px;
    background: var(--aweris-orange);
    display: inline-block;
  }

  #shopify-section-{{ section.id }} h1,
  #shopify-section-{{ section.id }} h2,
  #shopify-section-{{ section.id }} h3 {
    margin: 0;
    color: var(--aweris-blue);
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  #shopify-section-{{ section.id }} h1 {
    font-size: clamp(42px, 7vw, 88px);
  }

  #shopify-section-{{ section.id }} h2 {
    font-size: clamp(32px, 4.4vw, 58px);
  }

  #shopify-section-{{ section.id }} h3 {
    font-size: clamp(22px, 2vw, 30px);
  }

  #shopify-section-{{ section.id }} p {
    margin: 0;
    color: var(--aweris-muted);
    font-size: 17px;
    line-height: 1.7;
  }

  #shopify-section-{{ section.id }} .aweris-lead {
    font-size: clamp(18px, 2vw, 22px);
    color: var(--aweris-text);
  }

  #shopify-section-{{ section.id }} .aweris-button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  #shopify-section-{{ section.id }} .aweris-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 14px 22px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    border: 1px solid transparent;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  #shopify-section-{{ section.id }} .aweris-button:hover {
    transform: translateY(-2px);
  }

  #shopify-section-{{ section.id }} .aweris-button-primary {
    background: var(--aweris-orange);
    color: var(--aweris-white);
    box-shadow: 0 14px 30px rgba(233, 78, 26, .22);
  }

  #shopify-section-{{ section.id }} .aweris-button-secondary {
    background: rgba(255,255,255,.76);
    color: var(--aweris-blue);
    border-color: rgba(59, 64, 88, .16);
  }

  #shopify-section-{{ section.id }} .aweris-card {
    background: rgba(255,255,255,.82);
    border: 1px solid rgba(59,64,88,.12);
    border-radius: var(--aweris-radius);
    padding: 28px;
    box-shadow: 0 14px 38px rgba(59,64,88,.07);
  }

  #shopify-section-{{ section.id }} .aweris-card h3 {
    margin-bottom: 12px;
  }

  #shopify-section-{{ section.id }} .aweris-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  #shopify-section-{{ section.id }} .aweris-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media screen and (max-width: 990px) {
    #shopify-section-{{ section.id }} .aweris-grid-2,
    #shopify-section-{{ section.id }} .aweris-grid-3,
    #shopify-section-{{ section.id }} .aweris-split {
      grid-template-columns: 1fr !important;
    }
  }

  @media screen and (max-width: 700px) {
    #shopify-section-{{ section.id }} .aweris-container {
      padding-left: 18px;
      padding-right: 18px;
    }
    #shopify-section-{{ section.id }} .aweris-button {
      width: 100%;
    }
  }
</style>

<section class="aweris-section">
  <style>
    #shopify-section-{{ section.id }} .aweris-section {
      background: var(--aweris-blue) !important;
    }
    #shopify-section-{{ section.id }} h2,
    #shopify-section-{{ section.id }} h3 {
      color: white;
    }
    #shopify-section-{{ section.id }} p {
      color: rgba(255,255,255,.78);
    }
    #shopify-section-{{ section.id }} .aweris-card {
      background: rgba(255,255,255,.08);
      border-color: rgba(255,255,255,.15);
      box-shadow: none;
    }
    #shopify-section-{{ section.id }} .aweris-grid-3 {
      margin-top: 36px;
    }
  </style>

  <div class="aweris-container">
    {% if section.settings.eyebrow != blank %}<div class="aweris-eyebrow">{{ section.settings.eyebrow }}</div>{% endif %}
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}

    <div class="aweris-grid-3">
      {% for block in section.blocks %}
        <div class="aweris-card" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aweris 05 Features",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Platform features"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Everything needed to support the clinical workflow."
    },

    {
      "type": "header",
      "content": "Aweris brand settings"
    },
    {
      "type": "color",
      "id": "orange_color",
      "label": "Orange",
      "default": "#E94E1A"
    },
    {
      "type": "color",
      "id": "yellow_color",
      "label": "Soft yellow",
      "default": "#E9E11E"
    },
    {
      "type": "color",
      "id": "blue_color",
      "label": "Deep blue",
      "default": "#3B4058"
    },
    {
      "type": "color",
      "id": "cream_color",
      "label": "Cream",
      "default": "#F4EEDF"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#F4EEDF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Main text",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#5F6270"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max content width",
      "min": 900,
      "max": 1500,
      "step": 50,
      "default": 1200
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 72
    }

  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Intake reports"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Turn questionnaire and intake transcript material into a clear draft report for therapist review."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aweris 05 Features",
      "blocks": [
        {"type":"feature","settings":{"title":"Intake reports","text":"Turn questionnaire and intake transcript material into a clear draft report for therapist review."}},
        {"type":"feature","settings":{"title":"Treatment planning","text":"Create structured draft plans with goals, interventions, monitoring, and risk considerations."}},
        {"type":"feature","settings":{"title":"Session summaries","text":"Prepare clear summaries after sessions so important details are easier to keep and review."}},
        {"type":"feature","settings":{"title":"Homework and exercises","text":"Generate personalized between-session assignments that the therapist can edit and approve."}},
        {"type":"feature","settings":{"title":"Follow-up questionnaires","text":"Send patient-safe follow-up forms after therapy sessions and keep responses connected to the patient history."}},
        {"type":"feature","settings":{"title":"Transcription usage overview","text":"Give therapists a simple overview of transcription balance and usage history."}}
      ]
    }
  ]
}
{% endschema %}
